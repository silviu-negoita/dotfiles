[user]
	name = "<%= git_name %>"
	email = "<%= git_email %>"
[alias]
	co = checkout
	st = status --short --branch
	lg = log --graph --decorate --oneline --all
[color]
	ui = auto
[core]
	excludesFile = "<%= home %>/.gitignore"
	editor = vim
	autocrlf = input
[fetch]
	prune = true
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[format]
	pretty = %C(yellow)%h%Creset %s %C(red)(%an, %cr)%Creset
